{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MultipartWrite",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": ["arn:aws:s3:::file-sharing/*"]
    },
    {
      "Sid": "StatAndReconcile",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::file-sharing/*"]
    },
    {
      "Sid": "ListIncompleteUploads",
      "Effect": "Allow",
      "Action": ["s3:ListBucketMultipartUploads"],
      "Resource": ["arn:aws:s3:::file-sharing"]
    }
  ]
}
